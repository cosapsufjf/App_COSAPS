{
    "compilerOptions": {
        "target": "es6",
        "module": "es2020",
        "outDir": "dist",
        "strict": false,
        "allowJs": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "moduleResolution": "node",
        "noEmit": true,
        "allowImportingTsExtensions": true
    }
}